{
  "expo": {
    "name": "ScanTrack",
    "slug": "TapTrackDriverApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/scantrack-icon.png",
    "scheme": "taptrackdriverapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/scantrack-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dingsss.TapTrackDriverApp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Tap Track to access your camera to scan driver QR codes.",
          "barcodeScannerEnabled": true
        }
      ],
      "expo-notifications",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "57f53f2b-28e7-4031-89aa-f3edb6dce083"
      }
    }
  }
}
